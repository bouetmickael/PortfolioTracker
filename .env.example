# Port ecoute par le serveur Node a l'interieur du conteneur (ne pas changer
# sauf modification du Dockerfile)
PORT=3000

# Emplacement du fichier SQLite. Par defaut /data/portfolio.db (chemin de
# stockage persistant standard pour un Home Assistant Add-on ou le volume
# docker-compose). En dehors de Docker (ex. "node index.js" sur votre poste),
# decommenter la ligne suivante pour utiliser un chemin local a la place :
# DB_PATH=./data/portfolio.db

# Port expose sur le Raspberry Pi (celui utilise dans http://<ip-du-pi>:HOST_PORT)
HOST_PORT=3000

# Cle de signature des sessions, obligatoire : generer une valeur aleatoire
# longue, par exemple avec : openssl rand -hex 32
SESSION_SECRET=changez-moi-avec-une-valeur-aleatoire-longue

# Mettre a true uniquement si le service est servi en HTTPS (directement ou
# via un reverse proxy qui transmet le protocole d'origine)
COOKIE_SECURE=false
TRUST_PROXY=false

# Envoi d'email pour les alertes de seuil (optionnel : si non renseigne, les
# alertes sont seulement loguees, jamais inventees ni bloquantes)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
